# Base URL of the backend API (include /api, no trailing slash).
# Optional. If unset:
#   - `npm run dev` uses http://localhost:5000/api (matches server/.env PORT)
#   - production builds use same-origin /api (Vercel routes /api/* to the server)
# VITE_API_URL=http://localhost:5000/api

# Login: set to true to require login (must match server AUTH_ENABLED).
# VITE_AUTH_ENABLED=true
